  "measures": [
    {
      "id": "Issue 4",
      "title": "Mahoning County (Board of Developmental Disabilities) – Proposed Tax Levy (Additional)",
      "summary": "Asks whether Mahoning County may levy an additional property tax of up to 2.4 mills for 5 years, beginning in 2026 and first due in 2027. The money would pay for community programs and services and for acquiring, building, renovating, financing, maintaining and operating developmental disabilities facilities run by the Mahoning County Board of Developmental Disabilities. The county auditor estimates it will collect $15,522,964 a year, or $84 for each $100,000 of the auditor's market value.",
      "yesMeans": "The additional 2.4-mill levy for the Board of Developmental Disabilities takes effect for 5 years.",
      "noMeans": "The additional levy is not imposed.",
