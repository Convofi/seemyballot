  "measures": [
    {
      "id": "Wayne County Zoological Authority Proposal",
      "title": "Renewal of Wayne County Zoological Authority Millage in Support of the Detroit Zoo",
      "summary": "Renews the Wayne County Zoological Authority property tax that funds the Detroit Zoo, first approved in 2008 and renewed in 2016. It would levy 0.10 mill ($0.10 per $1,000 of taxable value) on all taxable property in Wayne County for ten years, 2028 through 2037, restoring the 0.0018 mill lost to required rollbacks. The official ballot language estimates $6,145,462 in the first year.",
      "yesMeans": "A YES vote renews and restores the 0.10 mill Detroit Zoo levy in Wayne County for 2028 through 2037.",
      "noMeans": "A NO vote does not renew the levy, so the Zoological Authority millage would not be collected after it expires.",
      "source": "https://www.waynecountymi.gov/files/assets/mainsite/v/1/clerk/documents/elections/official-proposal-list_november-3-2026-2_1.pdf"
    },
    {
      "id": "Southeast Michigan Public Historical Museum Authority Proposal",
      "title": "Southeast Michigan Public Historical Museum Authority Millage Proposal",
      "summary": "Creates a new 0.2 mill tax ($0.20 per $1,000 of taxable value) on all taxable property in Wayne County for ten years, 2026 through 2035, levied by a joint Wayne and Oakland County authority. The money would support the Charles H. Wright Museum of African American History, the Detroit Historical Museum, the Dossin Great Lakes Museum, and, through 15% of Wayne County revenue after administrative costs, other historical museums in Wayne County. The official ballot language estimates about $12,219,200 from Wayne County property in 2026.",
      "yesMeans": "A YES vote authorizes a new 0.2 mill tax in Wayne County for 2026 through 2035 to fund public historical museums.",
      "noMeans": "A NO vote does not authorize the new historical museum tax.",
      "source": "https://www.waynecountymi.gov/files/assets/mainsite/v/1/clerk/documents/elections/official-proposal-list_november-3-2026-2_1.pdf"
    }
  ],
