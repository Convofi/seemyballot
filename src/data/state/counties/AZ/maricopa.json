  "measures": [
    {
      "id": "Proposition 413",
      "title": "County Jails: Transaction Privilege Tax of One-Fifth of One Cent, the same rate as the existing jail facilities excise tax expiring in March 2027",
      "summary": "Referred by the Maricopa County Board of Supervisors under A.R.S. 42-6109.02. It would levy a countywide sales (transaction privilege) tax of one-fifth of one cent, the same rate as the current jail facilities excise tax that expires in March 2027, for up to 20 years. The money may be used only to build, renovate, maintain and operate adult and juvenile jail facilities and for programs meant to reduce jail costs.",
      "yesMeans": "A sales tax of one-fifth of one cent ($0.002) for county jail facilities and programs is approved, at the same rate as the current tax that is expiring.",
      "noMeans": "The one-fifth of one cent ($0.002) sales tax for jail facilities and programs is rejected, and the current tax expires in March 2027.",
      "source": "https://elections.maricopa.gov/asset/jcr:5af11871-7e96-4ad1-a13a-5492f096c005/2026%20General%20Election%20Publicity%20Pamphlet%20-%20Maricopa%20County%20-%20Website%20Version.pdf"
