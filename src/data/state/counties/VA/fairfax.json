    {
      "id": "Parks and Park Facilities Bonds",
      "title": "Parks and Park Facilities Bonds",
      "summary": "Asks whether Fairfax County may borrow up to $180,000,000 by issuing general obligation bonds for the Fairfax County Park Authority. The money would pay to acquire, build, develop and equip new parks and park facilities, preserve open-space land, and improve existing parks. The county's explanation lists current plans such as new parks and amenities, repairs to existing park facilities, rec center renovations (including Audrey Moore Rec Center), ecological restoration, historic site preservation and parkland acquisition.",
      "yesMeans": "Fairfax County is authorized to issue up to $180,000,000 in bonds for parks and park facilities.",
      "noMeans": "Fairfax County is not authorized to issue these park bonds.",
      "source": "https://www.fairfaxcounty.gov/elections/sites/elections/files/Assets/Documents/PDF/2026_November_11thCD_Full.pdf",
      "moreInfo": "https://www.fairfaxcounty.gov/bond/sites/bond/files/Assets/Documents/2026%20Plain%20Language%20Statements/Parks%20PLS%20Web%20English.pdf"
    },
    {
      "id": "Community Health and Human Services Facilities Bonds",
      "title": "Community Health and Human Services Facilities Bonds",
      "summary": "Asks whether Fairfax County may borrow up to $75,000,000 by issuing general obligation bonds for community health and human services facilities, including building, rebuilding, enlarging and equipping facilities and buying land. The county's explanation says it currently plans $35,000,000 to renovate or replace the Joanne Jorgenson Public Health Laboratory and $40,000,000 to renovate or replace facilities at the Tim Harmon Campus (A New Beginning, Fairfax Detox Center and the Cornerstone Facility).",
      "yesMeans": "Fairfax County is authorized to issue up to $75,000,000 in bonds for community health and human services facilities.",
      "noMeans": "Fairfax County is not authorized to issue these health and human services facility bonds.",
      "source": "https://www.fairfaxcounty.gov/elections/sites/elections/files/Assets/Documents/PDF/2026_November_11thCD_Full.pdf",
      "moreInfo": "https://www.fairfaxcounty.gov/bond/sites/bond/files/Assets/Documents/2026%20Plain%20Language%20Statements/CHHS%20PLS%20Web%20English.pdf"
    }
  ],
