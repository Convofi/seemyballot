  "measures": [
    {
      "id": "Proposition #1",
      "title": "One percent (1%) Specific Purpose Sales and Use Tax: Old Barnum Road and Barber Street, Town of Kaycee",
      "summary": "Asks whether Johnson County may impose an additional one percent specific purpose sales and use tax to raise $280,000 for planning, engineering and construction to improve the driving surface and drainage of Old Barnum Road and Barber Street from Nolan Avenue to Park Avenue in the Town of Kaycee. Each of the three specific purpose propositions stands alone and needs a majority of the votes cast on it.",
      "yesMeans": "The county may collect the additional 1% sales tax to fund this Kaycee street project.",
      "noMeans": "This project will not be funded by the additional 1% sales tax.",
      "source": "https://www.johnsoncowy.gov/posts/2026-sample-election-ballots"
    },
    {
      "id": "Proposition #2",
      "title": "One percent (1%) Specific Purpose Sales and Use Tax: North Burritt street reconstruction, City of Buffalo",
      "summary": "Asks whether Johnson County may impose an additional one percent specific purpose sales and use tax to raise $5,748,696.71 for planning, engineering and construction to reconstruct and pave North Burritt from Fort Street to Watkins Avenue in the City of Buffalo, including curb and gutter, sidewalk, water main and sewer main. Each of the three specific purpose propositions stands alone and needs a majority of the votes cast on it.",
      "yesMeans": "The county may collect the additional 1% sales tax to fund this Buffalo street project.",
      "noMeans": "This project will not be funded by the additional 1% sales tax.",
      "source": "https://www.johnsoncowy.gov/posts/2026-sample-election-ballots"
    },
    {
      "id": "Proposition #3",
      "title": "One percent (1%) Specific Purpose Sales and Use Tax: Rock Creek Road and Johnson Creek Road",
      "summary": "Asks whether Johnson County may impose an additional one percent specific purpose sales and use tax to raise $5,000,000 for planning, engineering and construction to improve and add safety upgrades to 5.3 miles of Rock Creek Road and Johnson Creek Road, from the east side of Interstate 90 west to French Creek Road. Each of the three specific purpose propositions stands alone and needs a majority of the votes cast on it.",
      "yesMeans": "The county may collect the additional 1% sales tax to fund this road project.",
      "noMeans": "This project will not be funded by the additional 1% sales tax.",
      "source": "https://www.johnsoncowy.gov/posts/2026-sample-election-ballots"
    },
    {
      "id": "Johnson County Senior Citizen Service District",
      "title": "Continue the Senior Citizen Service District levy of up to 1 mill",
      "summary": "Asks whether the Johnson County Senior Citizen Service District may continue to impose a levy of up to 1 mill on the taxable property in the district.",
      "yesMeans": "The district may continue its property tax levy of up to 1 mill.",
      "noMeans": "The district may not continue this levy.",
      "source": "https://www.johnsoncowy.gov/posts/2026-sample-election-ballots"
    }
  ],
