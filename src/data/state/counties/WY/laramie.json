    },
    {
      "id": "Laramie County Lodging Tax",
      "title": "Renewal of the two percent lodging tax",
      "summary": "Asks whether Laramie County may renew a lodging tax of two percent (2%) on the price paid for sleeping accommodations for guests in hotels, motels, tourist courts, trailer parks, campgrounds, dude ranches, short-term condominiums and similar establishments, under W.S. 39-15-204(a)(ii).",
      "yesMeans": "The county could continue the 2% tax on lodging.",
      "noMeans": "The county would not be authorized to renew the 2% lodging tax.",
