    {
      "id": "Laramie County 1% Sales & Use Tax",
      "title": "Renewal of the one percent general-purpose sales and use tax",
      "summary": "Asks whether the Laramie County Commissioners may renew a one percent (1%) sales and use tax within the county under W.S. 39-15-204. The revenue would be used as general revenue.",
      "yesMeans": "The county could continue the 1% general-purpose sales and use tax.",
      "noMeans": "The county would not be authorized to renew the 1% general-purpose sales and use tax.",
