      "measures": [
        {
          "id": "City of Columbia Falls Proposed Change to the Existing Plan of Government",
          "title": "City of Columbia Falls: self-governing powers",
          "summary": "The Columbia Falls Local Government Study Commission proposes moving the city from general-governing powers to self-governing powers. Under general-governing powers the city may use only powers specifically permitted by state law; under self-governing powers it could exercise any power not prohibited by state law, and it keeps all current powers.",
          "yesMeans": "A vote FOR Self-Governing Powers supports giving Columbia Falls authority to exercise any power not prohibited by state law.",
          "noMeans": "A vote FOR the existing General Governing Powers keeps the city limited to powers specifically permitted by state law.",
