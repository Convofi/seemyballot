    },
    {
      "id": "Charter Amendment 2",
      "title": "Council attendance and accountability",
      "summary": "Would amend the Lexington-Fayette Urban County Government Charter to require the Urban County Council to adopt attendance and accountability expectations for its members, effective for the term beginning January 4, 2027.",
      "yesMeans": "The Council would be required to adopt attendance and accountability expectations for its members starting with the term that begins January 4, 2027.",
      "noMeans": "The charter would not require the Council to adopt these expectations.",
      "source": "https://dt4647cgvo9o2.cloudfront.net/wp-content/uploads/2026/08/03090121/Charter-Questions-for-Ballot.pdf"
    },
    {
      "id": "Charter Amendment 3",
      "title": "Periodic charter review",
      "summary": "Would amend the Lexington-Fayette Urban County Government Charter to require a review of the Charter at least once every eight years by a deliberative body of residents chosen by representative lottery. It would also establish a permanent advisory body to recommend charter amendments, effective for the term beginning January 4, 2027.",
