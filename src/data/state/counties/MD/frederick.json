  "measures": [
    {
      "id": "Question A",
      "title": "Charter Amendment: Term limits for the County Council and County Executive",
      "summary": "Would change the Frederick County Charter so that a County Council member could serve no more than three terms in their lifetime and the County Executive no more than two terms in their lifetime. The current limits apply only to consecutive terms.",
      "yesMeans": "For: Council members are limited to three lifetime terms and the County Executive to two lifetime terms.",
      "noMeans": "Against: the current limits of three consecutive terms for Council members and two consecutive terms for the County Executive stay in place.",
      "source": "https://elections.maryland.gov/elections/2026/general_ballots/Frederick.pdf"
    }
