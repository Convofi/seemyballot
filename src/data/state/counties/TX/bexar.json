      "measures": [
        {
          "id": "Proposition A",
          "title": "City of San Antonio Proposition A: Pre-K 4 SA sales and use tax 20-year reauthorization",
          "summary": "Reauthorizes the Pre-K 4 SA early childhood education program and renews the city's sales and use tax at one-eighth of one percent to keep funding programs of the San Antonio Early Childhood Education Municipal Development Corporation. The renewal would run for up to 20 years after the current authorization expires in 2029.",
          "yesMeans": "The one-eighth cent sales and use tax for Pre-K 4 SA continues for up to 20 more years after 2029.",
          "noMeans": "The Pre-K 4 SA sales and use tax is not reauthorized beyond its current 2029 expiration.",
          "source": "https://elections.bexar.gov/DocumentCenter/View/1708/Generic-Sample-Ballot",
          "moreInfo": "https://elections.bexar.gov/163/Election-Information"
        }
      ]
    }
