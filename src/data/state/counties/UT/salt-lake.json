  "measures": [
    {
      "id": "Salt Lake County Special Bond Election",
      "title": "Salt Lake County Recreation General Obligation Bond",
      "summary": "Authorizes Salt Lake County to issue up to $128,000,000 in general obligation bonds, maturing within 11 years, to repair, complete, acquire, build or renovate open space, natural habitat, parks, community trails, recreational facilities and related county facilities. The official estimate is $16.39 per year in property tax on a $658,000 primary residence for the new bonds, but a net increase of $0 because older county bonds are being paid off. The county also estimates about $4.71 million a year in added operating and maintenance costs over the first ten years.",
      "yesMeans": "The county may issue up to $128 million in bonds for parks, trails, open space and recreation facilities, repaid by property taxes.",
      "noMeans": "The county may not issue these bonds.",
      "source": "https://www.saltlakecounty.gov/globalassets/1-site-files/clerk/elections/notices--petitions/2026/2026-general-election-sample-ballot.pdf",
      "moreInfo": "https://www.saltlakecounty.gov/globalassets/1-site-files/clerk/elections/2026-elections/salt-lake-county-bond/voter-information-pamphlet.pdf"
    }
  ],
