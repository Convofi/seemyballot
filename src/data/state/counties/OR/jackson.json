      "measures": [
        {
          "id": "Measure 15-243",
          "title": "Requiring Voter Approval for New or Increased Fee or Tax",
          "summary": "A citizen-initiated amendment to the Ashland City Charter. It would require that any new or increased fee or tax placed on a City utility bill, unrelated to operating the utilities, be approved by Ashland voters at the next regularly scheduled election and not be collected until at least 30 days after that vote. State and federal taxes and fees, franchise fees, increases needed to meet state minimums, and inflation increases not exceeding CPI-West are exempt.",
          "yesMeans": "New or increased City utility-bill fees or taxes unrelated to utility operations would need voter approval before taking effect.",
          "noMeans": "The Ashland Charter stays as it is, and the City Council can adopt such fees or taxes without a public vote.",
          "source": "https://www.jacksoncountyor.gov/Document%20Center/Departments/Clerk/Elections/General%20Elections/Nov%203,%202026/Jackson%20County%20Voters'%20Pamphlet%20(November%203,%202026).pdf",
