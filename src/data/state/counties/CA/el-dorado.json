  "measures": [
    {
      "id": "Measure S",
      "title": "The El Dorado County Emergency Preparedness, Healthcare Access, and Wildfire Prevention Initiative",
      "summary": "Asks whether to add a 3/8% special sales tax throughout El Dorado County, including Placerville and South Lake Tahoe, for 30 years, providing about $13 million a year. Per County Counsel's impartial analysis, the money is dedicated to local hospital facilities, fire agencies and wildfire-prevention nonprofits under set percentages, with an independent citizens' oversight committee and annual audits. It was placed on the ballot by voter petition.",
      "yesMeans": "A 3/8% sales tax for hospitals, fire protection and emergency response is added countywide for 30 years.",
      "noMeans": "The 3/8% sales tax is not added.",
      "source": "https://www.eldoradocounty.ca.gov/County-Government/Elections/Local-Measures-for-El-Dorado-County",
      "moreInfo": "https://www.eldoradocounty.ca.gov/files/assets/county/v/2/documents/government/elections/20261103/vip-complete-booklet.pdf"
