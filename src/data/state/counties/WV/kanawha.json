  "measures": [
    {
      "id": "Kanawha County Board of Education Additional Levies (Schools)",
      "title": "The Board of Education of the County of Kanawha: Election to Authorize Renewal of Additional Levies",
      "summary": "Renews the Kanawha County Board of Education's additional (excess) property tax levy for the five fiscal years beginning July 1, 2029. The money pays general school expenses in four listed areas: instruction, student services and operations; educator and employee salaries and benefits; facilities, safety, maintenance and technology; and athletics and extracurricular activities. The maximum rates are 21.91 cents (Class I), 43.82 cents (Class II) and 87.64 cents (Classes III and IV) per $100 of assessed value, and no levy funds may go to public charter schools.",
      "yesMeans": "The school excess levy would continue for the fiscal years beginning July 1, 2029 through July 1, 2033.",
      "noMeans": "The school excess levy would not be renewed for those years.",
      "source": "https://apps.sos.wv.gov/elections/2026GeneralSampleBallots/SAMPLE%20-%20WV%20Kanawha%20261103%20General%20-%2017inch.pdf"
    },
    {
      "id": "Kanawha County Board of Education Additional Levies (Public Libraries)",
      "title": "The Board of Education of the County of Kanawha: Election to Authorize Renewal of Additional Levies (Support for Public Libraries in Kanawha County)",
      "summary": "Renews an additional property tax levy collected through the Kanawha County Board of Education to partially fund public libraries, $3,183,675 a year for the five fiscal years beginning July 1, 2030. The money goes to the Kanawha County Public Library system ($2,912,108), South Charleston Public Library ($221,902) and Nitro Public Library ($49,665). The maximum rates are 1.04 cents (Class I), 2.08 cents (Class II) and 4.16 cents (Classes III and IV) per $100 of assessed value.",
      "yesMeans": "The library levy would continue for the fiscal years beginning July 1, 2030 through July 1, 2034.",
      "noMeans": "The library levy would not be renewed for those years.",
      "source": "https://apps.sos.wv.gov/elections/2026GeneralSampleBallots/SAMPLE%20-%20WV%20Kanawha%20261103%20General%20-%2017inch.pdf"
