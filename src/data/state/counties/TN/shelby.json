    "Memphis": {
      "contests": [],
      "measures": [
        {
          "id": "Ordinance No. 5966",
          "title": "City of Memphis Charter Referendum Ordinance No. 5966 (Civil Service exemptions)",
          "summary": "Rewrites Article 34, Section 250 of the Memphis Home Rule Charter, which lists the city officers and employees who are exempt from civil service rules. The amended list includes elected officers and judges, Board of Education and MLGW board members and employees, division directors, legal department employees, board and commission members, staff of the Mayor's and Chief Administrative Officer's offices, certain executive secretaries, library officers, City Council office employees, and other positions the Mayor and Council agree cannot be covered. It states that this last category cannot be used to remove civil service protection from anyone whose position is covered at that time; the city's Finance Director certified no impact on city revenues or expenditures.",
          "yesMeans": "Article 34, Section 250 of the charter is replaced with the amended list of positions exempt from civil service.",
          "noMeans": "The current text of Article 34, Section 250 of the charter stays in place.",
          "source": "https://www.electionsshelbytn.gov/wp-content/uploads/2026/09/Nov-3-2026-Official-Sample-2026-State-and-Federal-General-Election-and-Municipal-Elections-Paper-Ver-2.pdf"
        },
        {
          "id": "Ordinance No. 5977",
          "title": "City of Memphis Charter Referendum Ordinance No. 5977 (Lobbyist registration)",
          "summary": "Amends the Memphis Home Rule Charter to require the City Council to create, by ordinance, a process for lobbyists to register and disclose their activities. The city's Finance Director certified no impact on city revenues or expenditures.",
          "yesMeans": "The charter would require the City Council to set up a lobbyist registration and disclosure process by ordinance.",
          "noMeans": "The charter is not changed and does not require a lobbyist registration and disclosure process.",
          "source": "https://www.electionsshelbytn.gov/wp-content/uploads/2026/09/Nov-3-2026-Official-Sample-2026-State-and-Federal-General-Election-and-Municipal-Elections-Paper-Ver-2.pdf"
        },
        {
          "id": "Ordinance No. 5978",
          "title": "City of Memphis Charter Referendum Ordinance No. 5978 (Civil service appeals procedures)",
          "summary": "Amends the Memphis charter to let the City Council, in consultation with the Mayor, set by ordinance uniform administrative procedures for appeals that may affect a civil service employee's employment status. This includes setting the makeup of boards, commissions and hearing panels with people trained or experienced in labor and benefits matters. The city's Finance Director certified no impact on city revenues or expenditures.",
          "yesMeans": "The City Council, consulting the Mayor, could set uniform procedures and panel makeup for civil service employment appeals by ordinance.",
          "noMeans": "The charter is not changed to authorize these appeal procedures by ordinance.",
          "source": "https://www.electionsshelbytn.gov/wp-content/uploads/2026/09/Nov-3-2026-Official-Sample-2026-State-and-Federal-General-Election-and-Municipal-Elections-Paper-Ver-2.pdf"
        }
      ]
    },
