        {
          "id": "Proposition No. 1",
          "title": "Adoption of the Council-Manager Form of Government",
          "summary": "Under Resolution 2026-49, Benton City would abandon its mayor-council form of government and adopt the council-manager form, effective March 1, 2027. The elected council would hire a professional manager as chief administrative officer and choose a mayor from among its members to preside at meetings. The city would remain a code city under Title 35A RCW.",
          "yesMeans": "Benton City would switch to a council-manager government on March 1, 2027.",
          "noMeans": "Benton City would keep its mayor-council government with an elected mayor as chief administrative officer.",
          "source": "https://voter.votewa.gov/genericvoterguide.aspx?e=899&c=03#/measure/7271",
          "moreInfo": "https://voter.votewa.gov/genericvoterguide.aspx?e=899&c=03"
        },
        {
          "id": "Proposition No. 2",
          "title": "Community Safety Levy Lid Lift",
          "summary": "Under Resolution 2026-50, Benton City would restore its regular property tax levy rate to $1.60 per $1,000 of assessed value for collection in 2027 to fund law enforcement and code enforcement. For 2028-2036 the levy could rise each year by the Consumer Price Index for the Western Region, never exceeding $1.60 per $1,000. The 2036 levy would be used to calculate later levy limits.",
          "yesMeans": "Benton City could levy up to $1.60 per $1,000 of assessed value for community safety starting with 2027 collection.",
          "noMeans": "Benton City's property tax levy would not be restored to $1.60 per $1,000 under this measure.",
          "source": "https://voter.votewa.gov/genericvoterguide.aspx?e=899&c=03#/measure/7272",
          "moreInfo": "https://voter.votewa.gov/genericvoterguide.aspx?e=899&c=03"
        }
      ]
