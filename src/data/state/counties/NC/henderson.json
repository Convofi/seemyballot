  "measures": [
    {
      "id": "Henderson County Open Space Preservation Bonds Referendum",
      "title": "Henderson County Open Space Preservation Bonds",
      "summary": "Asks whether Henderson County may issue up to $25,000,000 in bonds to acquire and improve land or interests in land for open space and conservation, including protecting natural resources, preserving farmland and scenic landscapes, and buying development rights. The official ballot statement estimates the total cost over the life of the bonds at $39,028,000 ($25,000,000 principal plus $14,028,000 interest) and the property tax increase needed to repay them at $10.10 per year per $100,000 of property value. If approved, the county may levy additional property taxes sufficient to pay the principal and interest.",
      "yesMeans": "Henderson County may issue up to $25,000,000 in open space preservation bonds and levy property taxes sufficient to repay them.",
      "noMeans": "Henderson County may not issue these $25,000,000 in open space preservation bonds.",
