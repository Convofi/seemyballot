  "measures": [
    {
      "id": "Brunswick County School Bonds Referendum",
      "title": "Brunswick County School Bonds",
      "summary": "Asks whether Brunswick County may issue up to $349,600,000 in bonds to build, improve and renovate school facilities, including classrooms, furnishings and equipment, land and rights-of-way, and related public infrastructure. The official ballot statement estimates the total cost over the life of the bonds at $545,767,552 ($349,600,000 principal plus $196,167,552 interest) and the property tax increase needed to repay them at $54.66 per year per $100,000 of property value. If approved, the county may levy additional property taxes sufficient to pay the principal and interest.",
      "yesMeans": "Brunswick County may issue up to $349,600,000 in school bonds and levy property taxes sufficient to repay them.",
      "noMeans": "Brunswick County may not issue these $349,600,000 in school bonds.",
      "source": "https://s3.amazonaws.com/dl.ncsbe.gov/Elections/2026/Candidate%20Filing/referendums_20261103.pdf",
