  "measures": [
    {
      "id": "New Hanover County School Bonds Referendum",
      "title": "New Hanover County School Bonds",
      "summary": "Asks whether New Hanover County may issue up to $320,525,000 in bonds to build, improve and renovate school facilities, including classrooms, furnishings and equipment, land and rights-of-way, and related public infrastructure. The official ballot statement estimates the total cost over the life of the bonds at $500,377,988 ($320,525,000 principal plus $179,852,988 interest) and the property tax increase needed to repay them at $5.00 per year per $100,000 of property value, a figure that includes anticipated grants from the New Hanover Community Endowment of $11,600,000 per year for ten years beginning in February 2028. If approved, the county may levy additional property taxes sufficient to pay the principal and interest.",
      "yesMeans": "New Hanover County may issue up to $320,525,000 in school bonds and levy property taxes sufficient to repay them.",
      "noMeans": "New Hanover County may not issue these $320,525,000 in school bonds.",
      "source": "https://s3.amazonaws.com/dl.ncsbe.gov/Elections/2026/Candidate%20Filing/referendums_20261103.pdf"
    }
  ],
