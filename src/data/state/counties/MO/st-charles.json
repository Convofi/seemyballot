  "measures": [
    {
      "id": "Proposition PARAMEDICS",
      "title": "St. Charles County Ambulance District sales tax for paramedics and emergency medical services",
      "summary": "This question asks whether the St. Charles County Ambulance District, which serves all municipalities and unincorporated areas of St. Charles County, should impose a sales tax of 3/8 of 1% (0.375%) to fund its operations, including hiring paramedics and providing emergency medical services. Each year, the district's total property tax levy would be reduced by an amount equal to half of the previous year's revenue from this sales tax. The ballot states that for every five dollars spent on applicable purchases, the cost to a consumer would be less than two cents.",
      "yesMeans": "The ambulance district imposes a 3/8-cent sales tax for its operations, and its property tax levy is reduced each year by half of the prior year's sales tax revenue.",
      "noMeans": "The ambulance district does not impose this sales tax, and its property tax levy is not reduced under this question.",
      "source": "https://www.sccmo.org/DocumentCenter/View/29008",
