  "measures": [
    {
      "id": "Proposition A",
      "title": "St. Louis County Charter amendment: remove the term of office for the County Auditor",
      "summary": "This St. Louis County Charter amendment would change Sections 2.200 and 2.210 of the Charter to remove the term of office from the position of County Auditor, as set out in Exhibit A of County Ordinance No. 29,627. It needs a simple majority to pass.",
      "yesMeans": "The County Charter is amended so the County Auditor position no longer has a set term of office.",
      "noMeans": "The County Charter stays as it is, and the County Auditor position keeps its current term of office.",
      "source": "https://stlouiscovotes.maps.arcgis.com/sharing/rest/content/items/1728e79eea904603ae0112166efcdf6f/data"
    },
    {
      "id": "Proposition S",
      "title": "St. Louis County tax levy for services to persons 60 years of age or older",
      "summary": "St. Louis County would levy a property tax of five cents per $100 of assessed valuation. The money would be used to provide services to persons 60 years of age or older. It needs a simple majority to pass.",
      "yesMeans": "St. Louis County levies a tax of five cents per $100 of assessed valuation to fund services for people 60 and older.",
      "noMeans": "The county does not levy this tax for services to people 60 and older.",
      "source": "https://stlouiscovotes.maps.arcgis.com/sharing/rest/content/items/1728e79eea904603ae0112166efcdf6f/data"
    }
