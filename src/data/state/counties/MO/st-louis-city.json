  "measures": [
    {
      "id": "City Proposition 1",
      "title": "Charter amendment: use the nonpartisan top-two runoff system in special elections",
      "summary": "This City Charter amendment would repeal Section 5 of Article IV of the Charter so that special elections use the same nonpartisan, top-two runoff system already used in regular city elections.",
      "yesMeans": "City special elections would use the same nonpartisan, top-two runoff system as regular city elections.",
      "noMeans": "Section 5 of Article IV of the Charter stays in place, and special elections keep their current rules.",
      "source": "https://www.stlouis-mo.gov/government/departments/board-election-commissioners/documents/upload/Nov26-All-Races-Sample-Ballot.pdf"
    },
    {
      "id": "City Proposition B",
      "title": "Charter amendment: half-cent citywide sales tax for an Early Childhood Education Fund",
      "summary": "Proposed by initiative petition, this City Charter amendment would impose a citywide sales tax of one-half of one percent on all retail sales in St. Louis. The revenue would create an Early Childhood Education Fund for programs and services on the quality, affordability and access of early childhood education for children aged five and younger. A newly established St. Louis Early Childhood Education Board of Trustees would administer the money under a contract with the City.",
      "yesMeans": "The City adds a half-cent sales tax on retail sales to fund early childhood education for children five and younger, administered by a new board of trustees.",
      "noMeans": "The City does not impose this sales tax or create the Early Childhood Education Fund and board.",
      "source": "https://www.stlouis-mo.gov/government/departments/board-election-commissioners/documents/upload/Nov26-All-Races-Sample-Ballot.pdf"
    }
  ],
