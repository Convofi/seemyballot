  "measures": [
    {
      "id": "County Question 1",
      "title": "Preservation of Water Quality, Wildlife Habitat, and Natural Areas",
      "summary": "Asks whether Washington County may issue up to $40,000,000 in general obligation bonds to acquire and improve land under the Washington County Land and Water Legacy Program, to improve water quality in rivers, lakes and streams (including the St. Croix and Mississippi), protect drinking water, preserve wetlands, woodlands and natural areas, buy parkland and protect wildlife habitat. Spending would be limited to these purposes with public disclosure and an annual public audit. The ballot states it would cost about $24.60 a year for twenty years on a median-value homestead ($420,900) and that a yes vote is a vote for a property tax increase.",
      "yesMeans": "Washington County may issue up to $40 million in bonds for the Land and Water Legacy Program, raising property taxes.",
      "noMeans": "The bonds are not authorized.",
      "source": "https://myballotmn.sos.mn.gov/file/SampleBallotPdf/C0B456A7-651C-41DF-A76A-3774D75CFA93.pdf"
    }
  ],
