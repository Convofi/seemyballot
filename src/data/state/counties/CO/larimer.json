  "measures": [
    {
      "id": "Larimer County Ballot Issue 1A",
      "title": "Countywide 0.3% sales and use tax for wildfire and hazard resilience, infrastructure and community needs",
      "summary": "Creates a new 0.3% (30 cents on a $100 purchase) Larimer County sales and use tax starting January 1, 2027, estimated to raise up to $34.5 million in the first year, excluding food for home consumption, gasoline, diapers, prescription drugs and certain other exempt items. The money would go to wildfire, drinking-water source and natural hazard resilience; county bridges, roads, parks, trails and open spaces; and community resilience and public safety, including emergency services, public benefits, Justice Center and other facility improvements. Revenue would be independently audited each year, and the county could keep and spend all of it as an exception to TABOR limits.",
      "yesMeans": "Larimer County adds a 0.3% sales and use tax for the listed purposes and may keep and spend all of the revenue.",
      "noMeans": "The new county sales and use tax is not created.",
      "source": "https://www.larimer.gov/sites/default/files/2026ge-larimer-county-sample-ballot.pdf"
    }
