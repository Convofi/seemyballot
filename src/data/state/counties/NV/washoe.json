  "measures": [
    {
      "id": "Washoe County Advisory Ballot Question No. 1",
      "title": "Streets and Highways Funding Advisory Question (annual road use fee on electric and hybrid vehicles)",
      "summary": "An advisory, non-binding question asking whether voters support an annual, inflation-adjusted road use fee on electric and hybrid passenger vehicles registered in Washoe County, set to approximate what gasoline vehicle owners pay in local fuel taxes. Revenue would go to the Regional Transportation Commission of Washoe County for transportation projects, with annual audits. The result would be reported to the Nevada Legislature, which would have to pass a law before any such fee could be enacted.",
      "yesMeans": "Advises lawmakers that you approve the Legislature authorizing an annual fee on electric and hybrid passenger vehicles in Washoe County.",
      "noMeans": "Advises lawmakers that you do not approve the Legislature authorizing such a fee.",
      "source": "https://www.washoecounty.gov/voters/files/Washoe%20General%20Sample%20Ballot%20Booklet%20English.pdf",
      "moreInfo": "https://www.washoecounty.gov/voters/files/2026%20General%20Ballot%20Questions.pdf"
    }
