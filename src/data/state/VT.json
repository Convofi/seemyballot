    "measures": [
      {
        "id": "Proposal 3",
        "title": "Right to collectively bargain (proposed Article 23 of Chapter I of the Vermont Constitution)",
        "summary": "Passed by two sessions of the General Assembly, this amendment would add to the Vermont Constitution a right for employees to organize or join a labor organization and bargain collectively with their employer, through an exclusive representative of their choosing, over wages, hours, working conditions and workplace safety. It would bar any law that interferes with, negates or diminishes that right, or that prohibits enforcing an agreement requiring union membership as a condition of employment.",
        "yesMeans": "You want to add a right to collective bargaining to the Vermont Constitution.",
        "noMeans": "You want to leave the Vermont Constitution as it is; collective bargaining would remain governed by state and federal law.",
        "source": "https://governor.vermont.gov/sites/scott/files/documents/Proclamation%203%20Collective%20Bargaining.pdf",
        "moreInfo": "https://ballotpedia.org/Vermont_2026_ballot_measures"
      },
      {
        "id": "Proposal 4",
        "title": "Equality of rights (proposed Article 23 of Chapter I of the Vermont Constitution)",
        "summary": "Passed by two sessions of the General Assembly, this amendment would guarantee people equal protection under the law and bar the State from denying equal treatment because of race, ethnicity, sex, religion, disability, sexual orientation, gender identity, gender expression or national origin. It states that it may not be read to prevent measures intended to provide equal treatment and opportunity for groups historically subject to discrimination.",
        "yesMeans": "You want to add an equal protection guarantee covering these characteristics to the Vermont Constitution.",
        "noMeans": "You want to leave the Vermont Constitution as it is.",
        "source": "https://governor.vermont.gov/sites/scott/files/documents/Proclamation%204%20Civil%20Rights.pdf",
        "moreInfo": "https://ballotpedia.org/Vermont_2026_ballot_measures"
      }
