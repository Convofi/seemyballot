    "measures": [
      {
        "id": "Constitutional Amendment",
        "title": "Qualifications of electors (citizenship requirement for voting)",
        "summary": "Placed on the ballot by the Kansas Legislature, this amendment would rewrite Article 5, Section 1 of the Kansas Constitution to state that no person is a qualified elector unless they are a U.S. citizen, at least 18, and (with existing exceptions) live in the voting area where they seek to vote. The official explanatory statement says it would clarify that only U.S. citizens are eligible to vote in Kansas. The existing rules for voting for president after moving out of state, or in a former voting area after moving within Kansas, stay in place.",
        "yesMeans": "You approve the amendment, clarifying in the Kansas Constitution that only a U.S. citizen is eligible to vote in Kansas.",
        "noMeans": "The Kansas Constitution is not changed, and the language on voter qualifications stays the same.",
        "source": "https://sos.ks.gov/elections/26elec/2026-General-Election-Constitutional-Amendment-Citizen-Clarification.pdf",
