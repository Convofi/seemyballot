    "measures": [
      {
        "id": "Proposal 2026-1",
        "title": "A proposal to convene a constitutional convention for the purpose of drafting a general revision of the state constitution",
        "summary": "The Michigan Constitution requires this question to go to voters every 16 years; it was placed on the ballot automatically, not by the Legislature or a petition. If a majority votes yes, voters would elect 148 delegates (one per state House and Senate district) in 2027, and the convention would draft a general revision of the state constitution. Any revision the convention proposes would take effect only if voters later approve it.",
        "yesMeans": "A convention of elected delegates would be convened in 2027 to draft a general revision of the Michigan Constitution, which would then go to voters for approval or rejection.",
        "noMeans": "No constitutional convention is held, and the question returns to the ballot automatically in 2042.",
        "source": "https://www.house.mi.gov/hfa/PDF/Alpha/Ballot_Proposal_1_of_2026.pdf",
        "moreInfo": "https://ballotpedia.org/Michigan_Proposal_1,_Constitutional_Convention_Question_(2026)"
      },
      {
        "id": "Proposal 2026-2",
        "title": "A proposed initiated law to prohibit campaign contributions from certain regulated utilities and government contractors and apply campaign finance laws and regulations to additional types of political communications",
        "summary": "This citizen-initiated law would amend the Michigan Campaign Finance Act to bar regulated electric and gas utilities, contractors with more than $250,000 a year in government contracts, and people and organizations closely connected to them from making direct or indirect campaign contributions to those who run for or hold offices that affect them. It would also extend campaign finance rules, including donor disclosure, to communications that clearly identify candidates or ballot questions even if they do not expressly urge a vote for or against them. It would expressly require internet political communications to disclose who paid for them.",
        "yesMeans": "You approve the initiated law: the contribution bans for regulated utilities and large government contractors take effect, and disclosure and spending rules expand to cover more political communications, including internet ads.",
        "noMeans": "You reject the initiated law, and Michigan's current campaign finance laws stay as they are.",
        "source": "https://legislature.mi.gov/documents/2025-2026/initiative/Ballot_Proposal_2_of_2026.pdf",
        "moreInfo": "https://ballotpedia.org/Michigan_Proposal_2,_Utility_and_Government_Contractor_Campaign_Finance_Regulations_Initiative_(2026)"
      }
    ]
