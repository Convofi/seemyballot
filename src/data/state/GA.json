    "measures": [
      {
        "id": "Amendment 1",
        "title": "Increases the maximum qualifying acreage for assessment and taxation as bona fide conservation use property.",
        "summary": "Georgia lets owners of qualifying farm and timber land have it taxed on its current agricultural use instead of its market value if they agree to keep it in that use. Right now one owner can enroll at most 2,000 acres. This amendment (House Resolution 32) would raise that cap to 4,000 acres.",
        "yesMeans": "A single owner could have up to 4,000 acres of farm and timber land taxed at the lower conservation-use rate.",
        "noMeans": "The cap stays at 2,000 acres per owner.",
        "source": "https://www.legis.ga.gov/api/legislation/document/20252026/236234",
        "moreInfo": "https://ballotpedia.org/Georgia_2026_ballot_measures"
      },
      {
        "id": "Amendment 2",
        "title": "Provides for the nonpartisan election of all probate court judges.",
        "summary": "Probate judges handle wills, estates, guardianships and marriage licenses in each county; today some counties elect them with party labels and others without. This amendment (House Resolution 251) would require every county to elect probate judges in nonpartisan elections, as Georgia already does for superior court, state court and appellate judges.",
        "yesMeans": "All probate judges in Georgia would be elected without party labels.",
        "noMeans": "Probate judge elections stay as they are, with some counties continuing to hold partisan elections.",
        "source": "https://www.legis.ga.gov/api/legislation/document/20252026/248549",
        "moreInfo": "https://ballotpedia.org/Georgia_2026_ballot_measures"
      },
      {
        "id": "Amendment 3",
        "title": "Authorizes creation of Georgia Next Generation 9-1-1 Fund for 9-1-1 systems expansion, maintenance, and operation.",
        "summary": "This amendment (House Resolution 1243) would let the General Assembly create, by law, a Georgia Next Generation 9-1-1 Fund and dedicate revenue from specified sources to it. Money in the fund could be spent only on expanding, maintaining and operating 9-1-1 systems across the state, including the move to Next Generation 9-1-1, and would not lapse back to the general budget at year's end.",
        "yesMeans": "The legislature may set up a dedicated, non-lapsing fund that can be spent only on 9-1-1 systems.",
        "noMeans": "No dedicated 9-1-1 fund is authorized in the constitution; 9-1-1 money continues to go through the regular budget process.",
        "source": "https://www.legis.ga.gov/api/legislation/document/20252026/248550",
        "moreInfo": "https://ballotpedia.org/Georgia_2026_ballot_measures"
      }
    ]
