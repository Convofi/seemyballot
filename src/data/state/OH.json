    "measures": [
      {
        "id": "Issue 3",
        "title": "To Require Voters to Present Photo Identification in Order to Vote",
        "summary": "Proposed by the Ohio General Assembly, this amendment would add a photo ID requirement for voting to the Ohio Constitution (new Section 5 of Article V). Approved IDs would be an unexpired Ohio driver license or state ID card, a U.S. passport or passport card, or a U.S. military, Ohio National Guard, or U.S. Department of Veterans Affairs ID card; state law could allow another way to verify identity for voters with a sincere religious objection to being photographed. Voters who do not vote in person would also need approved photo ID unless state law lets them vote by giving a signature and at least one other specified identifier.",
        "yesMeans": "You approve adding the photo ID requirement to the Ohio Constitution. It would take effect immediately.",
        "noMeans": "You reject the amendment, and the Ohio Constitution is not changed.",
        "source": "https://wpassets.lakecountyohio.gov/wp-content/uploads/sites/12/2026/08/25154554/Issues-for-11-3-26-2.pdf"
      }
    ]
